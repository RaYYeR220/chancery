# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- working artifacts (never publish) ---
BRIEF.md
ALTERNATIVES.md
notes/
*-internal/
*-backup*
*.bundle
.remember/
MEMORY.md
superpowers/
docs/superpowers/
.agents/
.claude/
plans/
specs/
submission*.md
scratch*/
# UI exploration — only the chosen final UI ships
ui-prototypes/
mockups/
design-ref/
variants/
# media working files
video/
voiceover/

# the template ships; the filled-in copies never do
!.env.example
