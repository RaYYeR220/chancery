# Copy to .env.local and fill in. Nothing here is read at build time.
#
# `pnpm bench` and `pnpm verify` need none of this — the decision engine is pure
# and the verifier talks only to public DNS.

# --- LLM inference -----------------------------------------------------------
# OpenAI-compatible. Note that GET /models is public, so a smoke test that hits
# it will pass with any string; check credentials against /chat/completions.
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=gemini-3-8-flash

# --- Nutrient DWS ------------------------------------------------------------
# Reads the signed writ back into enforceable terms.
# Free tier is 50 credits/month and one page of `understand` extraction costs
# 15, so keep the writ short.
NUTRIENT_API_KEY=

# --- Foxit -------------------------------------------------------------------
# PDF Services: the reversible document work, exposed to the agent over MCP.
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# eSign: the signature ceremony.
#
# These belong to the server and nothing else. The agent-facing surface is
# constructed without them on purpose, so an agent that tries to send a document
# for signature gets a real 401 rather than a refusal it could argue with. If
# you find yourself passing these into agent code, the boundary is gone.
FOXIT_ESIGN_BASE_URL=https://na1.fusion.foxit.com
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=

# --- Doctavian ---------------------------------------------------------------
# Generates the writ. The API key is scoped per area: the documents key is
# rejected by the signatures endpoints and vice versa.
DOCTAVIAN_BASE_URL=https://api.doctavian.com
DOCTAVIAN_BEARER=
DOCTAVIAN_DOCUMENTS_KEY=
DOCTAVIAN_SIGNATURES_KEY=

# --- name.com ----------------------------------------------------------------
# Registration and the DNS anchor. `sandbox` gives free registrations against
# $100,000 of test credit, but its DNS never resolves publicly — so a sandbox
# writ cannot be verified from outside, only read back through the registrar.
#
# Two things will silently break this: signing up via Google SSO, and leaving
# two-factor authentication on without enabling "name.com API Access".
NAMECOM_ENV=sandbox
NAMECOM_USERNAME=
NAMECOM_TOKEN=

# --- SerpApi -----------------------------------------------------------------
# Live due diligence. The key travels in the query string; header auth is not
# documented for /search.
SERPAPI_KEY=

# --- Xano --------------------------------------------------------------------
# Registry, append-only ledger and act history.
# The free plan allows 10 requests per 20 seconds and does NOT enforce that
# limit inside Xano's own debugger, so test against the real URL.
XANO_BASE_URL=
XANO_TOKEN=

# --- Deployment --------------------------------------------------------------
# Where signed writs are published for verifiers to fetch. Keep it short: the
# whole WRIT1 record has to fit in a 255-byte DNS character-string.
CHANCERY_DOCUMENT_BASE_URL=https://chancery.example/w

# Accept authority from a DNS answer that was not DNSSEC-validated. Off by
# default. Needed only against a registrar sandbox, and every decision made
# under it records that it was made under it.
CHANCERY_ALLOW_UNAUTHENTICATED_DNS=false
